apiVersion: apps/v1
kind: Deployment
metadata:
  name: pgadmin
  namespace: {{ postgres_namespace }}
  labels:
    app: pgadmin
spec:
  replicas: 1
  selector:
    matchLabels:
      app: pgadmin
  template:
    metadata:
      labels:
        app: pgadmin
    spec:
      containers:
        - name: pgadmin
          image: {{ pgadmin_image }}
          ports:
            - containerPort: 80
          env:
            - name: PGADMIN_DEFAULT_EMAIL
              value: "{{ pgadmin_default_email }}"
            - name: PGADMIN_DEFAULT_PASSWORD
              value: "{{ pgadmin_default_password }}"
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
---
apiVersion: v1
kind: Service
metadata:
  name: pgadmin
  namespace: {{ postgres_namespace }}
spec:
  selector:
    app: pgadmin
  ports:
    - name: http
      port: 80
      targetPort: 80
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: pgadmin
  namespace: {{ postgres_namespace }}
spec:
  to:
    kind: Service
    name: pgadmin
  port:
    targetPort: http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
