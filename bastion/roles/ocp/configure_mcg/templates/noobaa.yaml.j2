apiVersion: noobaa.io/v1alpha1
kind: NooBaa
metadata:
  name: noobaa
  namespace: openshift-storage
spec:
  # Standalone mode: no StorageCluster/CephCluster reference anywhere in this spec.
  dbStorageClass: {{ mcg_backing_storage_class }}
  # Confirmed live: on AWS (and likely any cloud-detected platform) NooBaa
  # auto-detects the underlying infra and tries to provision its default backing
  # store as a cloud-native one (AWS S3 here) via a CredentialsRequest. On a cluster
  # using credentialsMode: Manual (required here — no internet route to IAM), CCO
  # marks that CredentialsRequest provisioned: true without ever writing the secret
  # NooBaa is waiting on, so the system sits in Configuring forever. Setting this
  # stops the operator from attempting that reconciliation at all — see
  # templates/noobaa-backingstore.yaml.j2/noobaa-bucketclass.yaml.j2, which this role
  # now creates explicitly instead.
  manualDefaultBackingStore: true
