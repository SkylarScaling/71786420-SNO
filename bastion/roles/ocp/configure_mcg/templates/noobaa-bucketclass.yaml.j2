apiVersion: noobaa.io/v1alpha1
kind: BucketClass
metadata:
  # Name confirmed live as the name NooBaa's own default OBC/account tooling expects
  # — must stay "noobaa-default-bucket-class".
  name: noobaa-default-bucket-class
  namespace: openshift-storage
spec:
  placementPolicy:
    tiers:
      - backingStores:
          - noobaa-default-backing-store
