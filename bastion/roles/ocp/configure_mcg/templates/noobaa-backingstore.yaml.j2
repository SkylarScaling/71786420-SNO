apiVersion: noobaa.io/v1alpha1
kind: BackingStore
metadata:
  # Name confirmed live against the actual bucket class NooBaa's console/CLI
  # tooling expects as the default — must stay "noobaa-default-backing-store".
  name: noobaa-default-backing-store
  namespace: openshift-storage
spec:
  type: pv-pool
  pvPool:
    numVolumes: 1
    storageClass: {{ mcg_backing_storage_class }}
    resources:
      requests:
        storage: {{ mcg_backing_pvc_size }}
