apiVersion: v1
kind: Namespace
metadata:
  name: openshift-storage
---
# No OperatorGroup here — configure_lvms already creates lvms-operator-group,
# targeting exactly this same namespace, and must run before this role (see
# mcg_backing_storage_class's default, which falls back to configure_lvms's own
# lvms_vg_name). OLM refuses a second OperatorGroup with overlapping
# targetNamespaces in the same namespace: confirmed live, this previously left the
# ClusterServiceVersion stuck forever with a "TooManyOperatorGroups" warning and the
# odf-operator Subscription's resolver reporting an unrelated ConstraintsNotSatisfiable
# error against the *other* subscription sharing the namespace. One OperatorGroup per
# namespace is enough for every Subscription that targets it.
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: odf-operator
  namespace: openshift-storage
spec:
  # MCG/NooBaa ships as part of the ODF operator package — same package name as
  # configure_odf's subscription. The difference is downstream: we never create a
  # StorageCluster/CephCluster CR, so no Ceph daemons get deployed, only NooBaa.
  channel: {{ mcg_channel }}
  name: odf-operator
  source: redhat-operators
  sourceNamespace: openshift-marketplace
  installPlanApproval: Automatic
