apiVersion: v1
kind: Namespace
metadata:
  name: {{ tempo_namespace }}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: tempo-operator-group
  namespace: {{ tempo_namespace }}
spec:
  targetNamespaces:
    - {{ tempo_namespace }}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: tempo-product
  namespace: {{ tempo_namespace }}
spec:
  # VERIFY: the Red Hat build of Tempo's OperatorHub package name is typically
  # `tempo-product` — confirm against the mirrored redhat-operators catalog, same
  # caveat as opentelemetry-product above.
  channel: {{ tempo_channel }}
  name: tempo-product
  source: redhat-operators
  sourceNamespace: openshift-marketplace
  installPlanApproval: Automatic
