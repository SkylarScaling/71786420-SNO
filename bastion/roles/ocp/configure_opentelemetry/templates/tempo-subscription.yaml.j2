{% if tempo_namespace != otel_namespace %}
# AllNamespaces (spec: {}), not targetNamespaces — same reasoning as
# otel-subscription.yaml.j2's OperatorGroup; see that file's comment.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ tempo_namespace }}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: tempo-operator-group
  namespace: {{ tempo_namespace }}
spec: {}
---
{% else %}
# tempo_namespace defaults to otel_namespace — reuse otel-subscription.yaml.j2's
# Namespace/OperatorGroup instead of creating a second, separately-named
# OperatorGroup in the same namespace, which OLM rejects with
# TooManyOperatorGroups regardless of InstallMode (same pattern configure_mcg uses
# to share configure_lvms's OperatorGroup in openshift-storage).
{% endif %}
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: tempo-product
  namespace: {{ tempo_namespace }}
spec:
  # VERIFY: the Red Hat build of Tempo's OperatorHub package name is typically
  # `tempo-product` — confirm against the mirrored redhat-operators catalog, same
  # caveat as opentelemetry-product above.
  channel: {{ tempo_channel }}
  name: tempo-product
  source: redhat-operators
  sourceNamespace: openshift-marketplace
  installPlanApproval: Automatic
