apiVersion: lvm.topolvm.io/v1alpha1
kind: LVMCluster
metadata:
  name: {{ lvms_vg_name }}
  namespace: openshift-storage
spec:
  storage:
    deviceClasses:
      - name: {{ lvms_vg_name }}
        default: true
        thinPoolConfig:
          name: {{ lvms_thin_pool_name }}
          sizePercent: 90
          overprovisionRatio: 10
{% if lvms_device_paths %}
        deviceSelector:
          paths:
{% for path in lvms_device_paths %}
            - {{ path }}
{% endfor %}
{% endif %}
