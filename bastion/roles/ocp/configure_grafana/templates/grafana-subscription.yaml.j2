apiVersion: v1
kind: Namespace
metadata:
  name: {{ grafana_namespace }}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: grafana-operator-group
  namespace: {{ grafana_namespace }}
spec:
  targetNamespaces:
    - {{ grafana_namespace }}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: grafana-operator
  namespace: {{ grafana_namespace }}
spec:
  channel: {{ grafana_channel }}
  name: grafana-operator
  source: {{ grafana_catalog_source }}
  sourceNamespace: {{ grafana_catalog_source_namespace }}
  installPlanApproval: Automatic
