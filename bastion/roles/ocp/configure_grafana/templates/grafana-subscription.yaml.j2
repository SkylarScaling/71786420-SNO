# No Namespace/OperatorGroup here — configure_lokistack already creates
# grafana_namespace (same namespace as loki_namespace by default) and its own
# cluster-wide loki-operator-group OperatorGroup, which must run first (see
# configure-logging.yaml's task order) and covers any Subscription in this
# namespace. OLM refuses a second OperatorGroup in one namespace — confirmed live,
# this previously left grafana-operator.v5.25.0 permanently Failed with
# TooManyOperatorGroups, the same failure mode configure_mcg hit against
# configure_lvms's OperatorGroup. If grafana_namespace is ever overridden to differ
# from loki_namespace, this Subscription will need its own Namespace/OperatorGroup
# added back.
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: grafana-operator
  namespace: {{ grafana_namespace }}
spec:
  channel: {{ grafana_channel }}
  name: grafana-operator
  source: {{ grafana_catalog_source }}
  sourceNamespace: {{ grafana_catalog_source_namespace }}
  installPlanApproval: Automatic
