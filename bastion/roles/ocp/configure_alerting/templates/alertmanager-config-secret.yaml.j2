apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-main
  namespace: openshift-monitoring
type: Opaque
stringData:
  alertmanager.yaml: |
    global:
      resolve_timeout: 5m
    route:
      receiver: email-notifications
      group_by: ['namespace']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 12h
    receivers:
      - name: email-notifications
        email_configs:
          - to: "{{ alert_email_to }}"
            from: "{{ alert_email_from }}"
            smarthost: "{{ alert_smtp_host }}:{{ alert_smtp_port }}"
            require_tls: false
            send_resolved: true
