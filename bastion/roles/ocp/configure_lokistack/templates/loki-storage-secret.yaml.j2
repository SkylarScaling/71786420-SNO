apiVersion: v1
kind: Secret
metadata:
  name: {{ loki_bucket_name }}-s3
  namespace: {{ loki_namespace }}
type: Opaque
stringData:
  # Field names required by LokiStack's spec.storage.secret (type: s3) — VERIFY
  # against `oc explain lokistack.spec.storage.secret` on a live cluster.
  access_key_id: "{{ obc_secret.resources[0].data.AWS_ACCESS_KEY_ID | b64decode }}"
  access_key_secret: "{{ obc_secret.resources[0].data.AWS_SECRET_ACCESS_KEY | b64decode }}"
  bucketnames: "{{ obc_configmap.resources[0].data.BUCKET_NAME }}"
  endpoint: "https://{{ obc_configmap.resources[0].data.BUCKET_HOST }}:{{ obc_configmap.resources[0].data.BUCKET_PORT }}"
  region: "us-east-1"
