apiVersion: velero.io/v1
kind: Schedule
metadata:
  name: {{ oadp_backup_schedule_name }}
  namespace: openshift-adp
spec:
  schedule: "{{ oadp_backup_schedule_cron }}"
  template:
{% if oadp_backup_scope == 'platform' %}
    includedNamespaces:
      - "*"
    excludedNamespaces:
{% for ns in oadp_backup_excluded_namespaces %}
      - {{ ns }}
{% endfor %}
    includeClusterResources: true
{% else %}
    includedNamespaces:
{% for ns in oadp_backup_stateful_namespaces %}
      - {{ ns }}
{% endfor %}
    includeClusterResources: false
{% endif %}
    snapshotVolumes: true
    defaultVolumesToFsBackup: true
    ttl: {{ oadp_backup_ttl }}
