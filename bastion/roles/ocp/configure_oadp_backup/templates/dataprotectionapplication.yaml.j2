apiVersion: oadp.openshift.io/v1alpha1
kind: DataProtectionApplication
metadata:
  name: {{ cluster_name }}-dpa
  namespace: openshift-adp
spec:
  configuration:
    velero:
      defaultPlugins:
        - openshift
        - aws
        - csi
    nodeAgent:
      enable: true
      uploaderType: kopia
  backupLocations:
    - velero:
        # provider/defaultPlugins' "aws" above is Velero's plugin name for any
        # S3-API-compatible backend, not the AWS cloud — this targets the in-cluster
        # NooBaa endpoint below, not a real AWS account.
        provider: aws
        default: true
        objectStorage:
          bucket: {{ backup_s3_bucket }}
          prefix: velero
        config:
          # Velero's aws plugin requires a non-empty region for SDK request signing
          # even against a non-AWS S3 endpoint — NooBaa doesn't have regions, so this
          # is a placeholder, not a real AWS region.
          region: noobaa
          profile: "default"
          s3Url: "https://s3.{{ noobaa_namespace }}.svc:443"
          s3ForcePathStyle: "true"
          insecureSkipTLSVerify: "true"
        credential:
          name: cloud-credentials
          key: cloud
