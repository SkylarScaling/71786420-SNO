apiVersion: v1
kind: Namespace
metadata:
  name: {{ rabbitmq_namespace }}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: rabbitmq-operator-group
  namespace: {{ rabbitmq_namespace }}
spec:
  targetNamespaces:
    - {{ rabbitmq_namespace }}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: rabbitmq-cluster-operator
  namespace: {{ rabbitmq_namespace }}
spec:
  channel: {{ rabbitmq_operator_channel }}
  name: rabbitmq-cluster-operator
  source: {{ rabbitmq_catalog_source }}
  sourceNamespace: {{ rabbitmq_catalog_source_namespace }}
  installPlanApproval: Automatic
