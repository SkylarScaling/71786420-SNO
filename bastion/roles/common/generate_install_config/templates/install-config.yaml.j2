apiVersion: v1
baseDomain: {{ base_domain }}
metadata:
  name: {{ cluster_name }}
compute:
- name: worker
  replicas: 0
controlPlane:
  name: master
  replicas: 1
networking:
  clusterNetwork:
  - cidr: {{ cluster_network_cidr }}
    hostPrefix: 23
  machineNetwork:
  - cidr: {{ machine_network_cidr }}
  networkType: OVNKubernetes
  serviceNetwork:
  - {{ service_network_cidr }}
platform:
  none: {}
pullSecret: '{{ _merged_pull_secret }}'
sshKey: |
  {{ ssh_key }}
# Every deployment is treated as disconnected (see docs/architectural-decisions.md #2)
# — content always comes from the mirror registry on the bastion, never directly
# from registry.redhat.io/quay.io.
imageContentSources:
  - mirrors:
      - "{{ mirror_registry_quay_hostname }}:{{ mirror_registry_quay_port }}/openshift/release-images"
    source: quay.io/openshift-release-dev/ocp-release
  - mirrors:
      - "{{ mirror_registry_quay_hostname }}:{{ mirror_registry_quay_port }}/openshift/release"
    source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
additionalTrustBundle: |
{{ mirror_registry_ca_cert | indent(2, true) }}
{% if ntp_server is defined %}
# Customer-provided NTP server.
additionalNTPSources:
  - {{ ntp_server }}
{% endif %}
