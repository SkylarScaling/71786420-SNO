apiVersion: v1
kind: Namespace
metadata:
  name: {{ keycloak_namespace }}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: keycloak-operator-group
  namespace: {{ keycloak_namespace }}
spec:
  targetNamespaces:
    - {{ keycloak_namespace }}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: {{ keycloak_operator_package }}
  namespace: {{ keycloak_namespace }}
spec:
  channel: {{ keycloak_operator_channel }}
  name: {{ keycloak_operator_package }}
  source: {{ keycloak_catalog_source }}
  sourceNamespace: {{ keycloak_catalog_source_namespace }}
  installPlanApproval: Automatic
