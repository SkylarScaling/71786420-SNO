apiVersion: v1
kind: Namespace
metadata:
  name: {{ otel_namespace }}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: opentelemetry-operator-group
  namespace: {{ otel_namespace }}
spec:
  targetNamespaces:
    - {{ otel_namespace }}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: opentelemetry-product
  namespace: {{ otel_namespace }}
spec:
  # VERIFY: the Red Hat build of OpenTelemetry's OperatorHub package name is typically
  # `opentelemetry-product` — confirm against the mirrored redhat-operators catalog
  # (package names for Red Hat "distro" builds of upstream operators have changed
  # before, e.g. during rebrands).
  channel: {{ otel_channel }}
  name: opentelemetry-product
  source: redhat-operators
  sourceNamespace: openshift-marketplace
  installPlanApproval: Automatic
