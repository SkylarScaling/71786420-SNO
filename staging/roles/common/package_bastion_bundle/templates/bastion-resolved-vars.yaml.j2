---
# Generated by package_bastion_bundle from staging/inventory/inventory.yaml — do not
# hand-edit. Written verbatim to bastion/playbooks/group_vars/all.yaml by
# unpack_bastion_bundle. If you add a new per-environment var to
# staging/inventory/inventory-baremetal.yaml or inventory-aws.yaml.j2, add it here too
# so it actually reaches the bastion. Provider-specific vars (AWS VPC/subnet facts vs.
# BMC/agent-ISO networking) are split below by infra_provider so each provider's
# inventory only has to define what it actually uses.
cluster_name: "{{ cluster_name }}"
openshift_version: "{{ openshift_version }}"
infra_provider: "{{ infra_provider }}"
base_domain: "{{ base_domain }}"

ssh_key: "{{ ssh_key }}"
pull_secret: {{ pull_secret | to_json }}

tmp_dir: "{{ tmp_dir }}"
install_dir: "{{ install_dir }}"
sno_kubeconfig: "{{ sno_kubeconfig }}"

machine_network_cidr: "{{ machine_network_cidr }}"
cluster_network_cidr: "{{ cluster_network_cidr }}"
service_network_cidr: "{{ service_network_cidr }}"

{% if infra_provider == 'aws' %}
# AWS platform only — produced by aws-infra/playbooks/provision-hosts.yaml and copied
# into staging/inventory/inventory.yaml by the operator (see that playbook's printed
# connection-info message), consumed here by bastion/roles/common/
# generate_install_config's AWS branch.
aws_region: "{{ aws_region }}"
sno_vpc_id: "{{ sno_vpc_id }}"
sno_vpc_cidr: "{{ sno_vpc_cidr }}"
sno_private_subnet_id: "{{ sno_private_subnet_id }}"
sno_public_subnet_id: "{{ sno_public_subnet_id }}"
sno_public_subnet_cidr: "{{ sno_public_subnet_cidr }}"
{% else %}
# Dell iDRAC BMC (bastion/roles/baremetal/baremetal_boot_node_via_bmc) — bare metal only.
bmc_address: "{{ bmc_address }}"
bmc_username: "{{ bmc_username }}"
bmc_password: "{{ bmc_password }}"
iso_http_url: "{{ iso_http_url }}"

# Agent-based install networking (bastion/roles/baremetal/baremetal_generate_agent_iso) — bare metal only.
rendezvous_ip: "{{ rendezvous_ip }}"
sno_mac_address: "{{ sno_mac_address }}"
default_gateway: "{{ default_gateway }}"
dns_server: "{{ dns_server }}"
ntp_server: "{{ ntp_server }}"
{% if sno_network_topology is defined %}
sno_network_topology: "{{ sno_network_topology }}"
sno_interface_name_secondary: "{{ sno_interface_name_secondary }}"
sno_mac_address_secondary: "{{ sno_mac_address_secondary }}"
{% endif %}
{% endif %}

lvms_device_paths: {{ lvms_device_paths | default([]) | to_json }}

# metallb_address_pool: bare-metal production only — the AWS test loop doesn't run
# configure-metallb.yaml at all (MetalLB's L2Advertisement mode can't work on AWS's
# L3-routed VPC), so this is left unset there.
metallb_address_pool: {{ metallb_address_pool | default('') | to_json }}

alert_smtp_host: "{{ alert_smtp_host | default('') }}"
alert_email_to: "{{ alert_email_to | default('') }}"

mirror_registry_quay_hostname: "{{ mirror_registry_quay_hostname }}"
mirror_registry_quay_port: {{ mirror_registry_quay_port }}

backup_s3_bucket: "{{ backup_s3_bucket }}"

backup_egress_mode: "{{ backup_egress_mode | default('media') }}"
backup_external_s3_endpoint: "{{ backup_external_s3_endpoint | default('') }}"
backup_external_s3_bucket: "{{ backup_external_s3_bucket | default('') }}"
backup_external_s3_access_key: "{{ backup_external_s3_access_key | default('') }}"
backup_external_s3_secret_key: "{{ backup_external_s3_secret_key | default('') }}"

log_forward_endpoint: "{{ log_forward_endpoint | default('') }}"
