---
# Generated by aws-infra/playbooks/provision-hosts.yaml, AFTER the VPC/subnets exist
# (not by configure-aws-env.yaml — that runs first but doesn't have these facts yet).
# Don't hand-edit; re-run provision-hosts.yaml instead. The completed file is scp'd to
# the mirror-staging host's $HOME automatically as part of that same run — see
# staging/README.md's "AWS" section for the one remaining manual step (moving it into
# place once you've git-cloned the repo there, since the clone doesn't exist yet at
# the point this file is pushed over).
#
# aws_access_key_id/aws_secret_access_key/aws_region are read from a local
# per-environment credentials file (not ~/.aws/credentials), the same way
# pull_secret/ssh_key are read via lookup('file', ...) below — provision-hosts.yaml
# also copies that credentials file to the mirror-staging host's $HOME, since this
# lookup is evaluated wherever staging/ actually runs, not where this template is
# rendered.
all:
  vars:
    # --- Identity ---
    cluster_name: sno-test   # TODO: must match aws-infra/inventory/inventory.yaml's cluster_name
    openshift_version: "4.22.17"
    infra_provider: aws
    base_domain: {{ base_domain }}

    # --- AWS credentials/network facts ---
    aws_key_pair: {{ aws_key_pair }}
{% raw %}
    aws_creds_file: "{{ lookup('env', 'HOME') }}/tmp/{{ base_domain }}-creds"
    aws_creds: "{{ lookup('file', aws_creds_file) | from_json }}"
    aws_access_key_id: "{{ aws_creds.aws_access_key_id }}"
    aws_secret_access_key: "{{ aws_creds.aws_secret_access_key }}"
    aws_region: "{{ aws_creds.aws_region }}"
{% endraw %}
    sno_vpc_id: {{ sno_vpc_id }}
    sno_vpc_cidr: {{ sno_vpc_cidr }}
    sno_private_subnet_id: {{ sno_private_subnet_id }}
    sno_public_subnet_id: {{ sno_public_subnet_id }}
    sno_public_subnet_cidr: {{ sno_public_subnet_cidr }}

    # --- Bastion bundle transfer (package_bastion_bundle) ---
    # media (package_bastion_bundle's own default) assumes no network path exists
    # between staging and the bastion at all — true on bare metal, false here: a real
    # VPC path exists, and the bastion has no removable-media slot to carry a tar.gz
    # to in the first place. bastion_private_ip/bastion_ssh_user are already known at
    # this render time (set by aws_provision_bastion, exposed to this play by
    # provision-hosts.yaml's `public: true` on that include_role) — deliberately
    # outside any raw-templating block, since this needs to resolve now, not when
    # staging/ later runs.
    bastion_transfer_method: rsync
    bastion_transfer_host: {{ bastion_private_ip }}
    bastion_transfer_user: {{ bastion_ssh_user }}
    bastion_transfer_dest_dir: "/home/{{ bastion_ssh_user }}"

{% raw %}
    # --- Credentials / keys ---
    ssh_key: "{{ lookup('file', '~/.ssh/id_ed25519.pub') }}"
    ssh_private_key: "~/.ssh/id_ed25519"
    # Kept as the raw JSON text (not parsed with | from_json) — generate_install_config's
    # install-config.yaml.j2 embeds this directly as `pullSecret: '{{ pull_secret }}'`,
    # which needs the literal JSON string, not a dict.
    pull_secret: "{{ lookup('file', '~/pull-secret.json') }}"

    # --- Working directories (bastion-side; meaningful once unpacked there; staging
    # uses the same values locally too, for unpack_install_config_bundle/
    # aws_provision_sno_ipi) ---
    tmp_dir: "/tmp/{{ cluster_name }}"
    install_dir: "{{ tmp_dir }}/install"
    sno_kubeconfig: "{{ install_dir }}/auth/kubeconfig"
{% endraw %}

    # --- Network emulation (must match aws-infra/inventory/inventory.yaml.j2's
    # machine_network_cidr — aws_provision_network's private_subnet_cidr default
    # reuses it, so the VPC and install-config.yaml always agree) ---
    machine_network_cidr: "10.0.0.0/24"
    cluster_network_cidr: "10.128.0.0/14"
    service_network_cidr: "172.30.0.0/16"

    # --- Storage (roles/ocp/configure_lvms, roles/ocp/configure_mcg) ---
    lvms_device_paths: ["/dev/nvme1n1"]   # TODO: confirm the actual EBS device name on bastion_instance_type

{% raw %}
    # --- Disconnected mirroring (always on — see docs/architectural-decisions.md #2) ---
    # mirror_registry_quay_port isn't set here — it's a cross-tree constant (also
    # needed by aws-infra/), sourced from the repo-root shared-defaults.yaml via
    # playbooks/group_vars/all.yaml instead; see that file's header comment.
    mirror_registry_quay_hostname: "mirror.{{ base_domain }}"

    # --- Backup / DR target (in-cluster) ---
    backup_s3_bucket: "{{ cluster_name }}-oadp-backup"
{% endraw %}

    # --- Backup/log export egress — AWS test loop only exercises storage/logging/
    # backup-dr (see docs/aws-test-environment-architecture.md), 'media' is the safe
    # default here too.
    backup_egress_mode: media
  hosts:
    localhost:
      ansible_connection: local
