---
# Generated by playbooks/configure-aws-env.yaml. Don't hand-edit — re-run that
# playbook instead. This is aws-infra/'s own inventory, used only by
# provision-hosts.yaml/destroy-hosts.yaml — it has no relationship to
# staging/inventory/inventory.yaml or bastion/inventory/inventory.yaml beyond sharing
# the same cluster_name/base_domain values (keep them in sync by hand —
# provision-hosts.yaml separately renders staging's AWS inventory once VPC/subnet
# facts exist, from the same prompted base_domain, so they start in sync — just
# don't edit one without the other afterward).
#
# mirror_staging_host and bastion aren't listed here — provision-hosts.yaml only
# creates the EC2 instances; it doesn't add them to any in-memory inventory (see
# aws_provision_bastion's README for how the operator reaches them manually).
#
# automation_repo_url/automation_repo_ref are NOT rendered here — they're constant
# across environments (this repo's own git location/branch), not per-environment
# config, so they live in playbooks/group_vars/all.yaml instead.
all:
  vars:
    cluster_name: sno-test   # TODO: must match staging/inventory/inventory.yaml's cluster_name
    base_domain: {{ aws_base_domain }}
    aws_key_pair: {{ aws_key_pair }}
{% raw %}
    aws_creds_file: "{{ lookup('env', 'HOME') }}/tmp/{{ base_domain }}-creds"
    aws_creds: "{{ lookup('file', aws_creds_file) | from_json }}"
    aws_access_key_id: "{{ aws_creds.aws_access_key_id }}"
    aws_secret_access_key: "{{ aws_creds.aws_secret_access_key }}"
    aws_region: "{{ aws_creds.aws_region }}"
{% endraw %}

    # Same value as staging/inventory/inventory.yaml's machine_network_cidr —
    # aws_provision_network's private_subnet_cidr default reuses it so the VPC and
    # install-config.yaml always agree on the network. Keep both in sync by hand.
    machine_network_cidr: "10.0.0.0/24"

    ssh_private_key: "~/.ssh/id_ed25519"
  hosts:
    localhost:
      ansible_connection: local
