---
# Generated by playbooks/configure-aws-env.yaml — one of these per AWS test
# environment (one per base_domain), so multiple environments can be provisioned in
# parallel with `-i inventory/aws/{{ aws_base_domain }}.yaml` without colliding.
# Don't hand-edit; re-run configure-aws-env.yaml instead.
#
# mirror_staging_host and bastion aren't listed here — they're EC2 instances created
# and added to in-memory inventory at runtime by aws_provision_mirror_staging_host
# and aws_provision_bastion.
#
# aws_access_key_id/aws_secret_access_key/aws_region are read from a local
# per-environment credentials file (not ~/.aws/credentials), the same way
# pull_secret/ssh_key are read via lookup('file', ...) elsewhere in this repo.
all:
  vars:
    infra_provider: aws
    base_domain: {{ aws_base_domain }}
    aws_key_pair: {{ aws_key_pair }}
{% raw %}
    aws_creds_file: "{{ lookup('env', 'HOME') }}/tmp/{{ base_domain }}-creds"
    aws_creds: "{{ lookup('file', aws_creds_file) | from_json }}"
    aws_access_key_id: "{{ aws_creds.aws_access_key_id }}"
    aws_secret_access_key: "{{ aws_creds.aws_secret_access_key }}"
    aws_region: "{{ aws_creds.aws_region }}"
{% endraw %}
  hosts:
    localhost:
      ansible_connection: local
